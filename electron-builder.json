{
    "appId": "com.junglegreen.app",
    "productName": "JungleGreen",
    "files": ["dist-electron", "dist-react"],
    "extraResources": [
        "dist-electron/preload.cjs",
        "assets/**/*.png"
    ],
    "mac": {
        "icon": "build/icon.icns",
        "target": ["dmg"]
    },
    "win": {
        "icon": "build/icon.ico",
        "target": ["portable", "msi"]
    },
    "linux": {
        "icon": "build/icons",
        "target": ["AppImage"],
        "category": "Utility",
        "syncDesktopName": true
    }
}
