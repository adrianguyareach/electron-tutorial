{
  "name": "electron-tutorial",
  "private": true,
  "version": "0.0.0",
  "description": "Jungle Green desktop app",
  "author": "Adrian Guya <adrian.guya@wezacare.org>",
  "type": "module",
  "main": "dist-electron/main.js",
  "desktopName": "jungle-green.desktop",
  "scripts": {
    "dev": "pnpm dev:electron",
    "dev:react": "vite",
    "dev:electron": "pnpm transpile:electron && concurrently -k --names vite,tsc,electron --prefix-colors cyan,yellow,magenta \"vite\" \"tsc --project src/electron/tsconfig.json --watch --preserveWatchOutput\" \"wait-on http-get://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 nodemon\"",
    "build": "tsc -b && vite build && pnpm transpile:electron",
    "lint": "eslint .",
    "preview": "vite preview",
    "transpile:electron": "tsc --project src/electron/tsconfig.json && node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('src/electron/package.json', 'dist-electron/package.json');\"",
    "dist": "pnpm run build && electron-builder",
    "dist:win": "pnpm run build && electron-builder --win --x64",
    "dist:mac": "pnpm run build && electron-builder --mac --x64",
    "dist:linux": "pnpm run build && electron-builder --linux --x64"
  },
  "dependencies": {
    "os-utils": "^0.0.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/os-utils": "^0.0.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "nodemon": "^3.1.14",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  }
}
